{
  "name": "flight-tracker-fe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "proxy:dev": "bun run --bun wrangler dev --config proxy/wrangler.jsonc",
    "proxy:deploy": "bun run --bun wrangler deploy --config proxy/wrangler.jsonc",
    "proxy:secret": "bun run --bun wrangler secret put AIRLABS_API_KEY --config proxy/wrangler.jsonc"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "maplibre-react-components": "0.2.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
