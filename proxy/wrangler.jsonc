{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "flight-tracker-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "dev": {
    "ip": "localhost",
    "port": 8787,
    "local_protocol": "http"
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
